#!/usr/bin/env bash
# UplinkView – polecenie zarządzające na serwerze (/usr/local/bin/uplinkview; dawna nazwa `netpulse` działa dalej).
#
#   uplinkview update          pobierz najnowszą wersję z GitHuba i zrestartuj usługi
#   uplinkview status          stan usług
#   uplinkview logs [usługa]   logi (collector | api | db), Ctrl+C kończy
#   uplinkview restart         uruchom usługi od nowa z aktualnym .env
#   uplinkview stop|start
#   uplinkview version
#   uplinkview uninstall       usuń UplinkView (z pytaniem o usunięcie danych)
#   uplinkview reset           wyczyść bazę (urządzenia i historia) i uruchom od nowa
#   uplinkview cleanup         zwolnij miejsce: nieużywane obrazy i cache budowania (baza zostaje)
#   uplinkview backup          kopia bazy do katalogu backups (przywracanie: panel → Ustawienia → Kopia zapasowa);
#                              użytkownik z grupy docker nie potrzebuje sudo
#
# Pozostałe polecenia trafiają do aplikacji w kontenerze, np.:
#   uplinkview probe 192.168.1.1 --community public
#   uplinkview device add "UCG Ultra" 192.168.1.1 --community public
#   uplinkview device list
set -euo pipefail

# Katalog instalacji: NETPULSE_DIR, a bez niego katalog, w którym leży ten skrypt (/usr/local/bin/uplinkview to dowiązanie
# do <katalog>/scripts/netpulse). Nowe instalacje są w /opt/uplinkview, sprzed zmiany nazwy (0.78.0) – w /opt/netpulse.
np_install_dir() {
  local self
  self=$(readlink -f "$0" 2>/dev/null || echo "$0")
  if [ -f "$(dirname "$self")/../deploy/docker-compose.yml" ]; then
    (cd "$(dirname "$self")/.." && pwd)
  elif [ -d /opt/uplinkview/deploy ]; then
    echo /opt/uplinkview
  else
    echo /opt/netpulse
  fi
}
INSTALL_DIR="${NETPULSE_DIR:-$(np_install_dir)}"
COMPOSE_FILE="$INSTALL_DIR/deploy/docker-compose.yml"
ENV_FILE="$INSTALL_DIR/deploy/.env"

c_info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
c_ok() { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
c_err() { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; }

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    # Bez `sudo -E` – sudo-rs (Ubuntu 25.10+) go nie obsługuje; przekazujemy tylko to, co potrzebne
    exec sudo env NETPULSE_DIR="$INSTALL_DIR" "$0" "$@"
  fi
}

# Nazwa i adresy IPv4 serwera do certyfikatu HTTPS (bez sieci Dockera), przecinkami
np_tls_names() {
  local ips
  ips=$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 !~ /^(docker|br-|veth|virbr)/ {sub(/\/.*/, "", $4); print $4}')
  [ -n "$ips" ] || ips=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9.]+$' | grep -v '^172\.1[7-9]\.' || true)
  { hostname -s 2>/dev/null; hostname -f 2>/dev/null; echo "$ips"; } | tr 'A-Z' 'a-z' | grep -E '^[a-z0-9][a-z0-9.:-]*$' \
    | grep -v '^localhost' | sort -u | paste -sd, -
}

# Uzupełnia NETPULSE_TLS_NAMES w .env, gdy brak albo puste (instalacja sprzed 0.62.0, aktualizacja z panelu)
np_fill_tls_names() {
  local env_file=$1 names
  if grep -q '^NETPULSE_TLS_NAMES=..*' "$env_file" 2>/dev/null; then return 0; fi
  names=$(np_tls_names || true)
  [ -n "$names" ] || return 0
  if grep -q '^NETPULSE_TLS_NAMES=' "$env_file"; then
    sed -i "s|^NETPULSE_TLS_NAMES=.*|NETPULSE_TLS_NAMES=${names}|" "$env_file"
  else
    echo "NETPULSE_TLS_NAMES=${names}" >>"$env_file"
  fi
}

# Polecenie `uplinkview` (od 0.78.0) obok dawnego `netpulse` – oba wskazują ten skrypt. Instalacja sprzed zmiany nazwy
# dostaje nowe polecenie przy pierwszym uruchomieniu z uprawnieniami roota (np. `sudo netpulse update`).
np_ensure_links() {
  [ "$(id -u)" -eq 0 ] || return 0
  [ -d /usr/local/bin ] || return 0
  local target="$INSTALL_DIR/scripts/netpulse" name
  for name in uplinkview netpulse; do
    [ "$(readlink -f "/usr/local/bin/$name" 2>/dev/null)" = "$(readlink -f "$target")" ] || ln -sf "$target" "/usr/local/bin/$name" 2>/dev/null || true
  done
}

# Repozytorium przeniesione przy zmianie nazwy (0.78.0): stary adres GitHuba → nowy. Bez zmiany, gdy w .env jest
# własne źródło aktualizacji (NETPULSE_UPDATE_REPO).
NP_REPO="https://github.com/uplinkview/uplinkview.git"
np_migrate_origin() {
  local url
  grep -q '^NETPULSE_UPDATE_REPO=..*' "$ENV_FILE" 2>/dev/null && return 0
  url=$(git -C "$INSTALL_DIR" remote get-url origin 2>/dev/null) || return 0
  if printf '%s' "$url" | grep -qiE 'github\.com[/:]arkadiuszbaglaj/netpulse(\.git)?/?$'; then
    git -C "$INSTALL_DIR" remote set-url origin "$NP_REPO"
    c_info "Nowy adres repozytorium: $NP_REPO"
  fi
}

compose() {
  docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
}

# Restart usług z aktualnym .env (od 0.71.1). Samo `docker compose restart` zostawia kontenerom stare zmienne –
# zmiana w .env (np. NETPULSE_PEAK_INTERVAL) działała dopiero po `uplinkview start`. Dane są w wolumenach, zostają.
restart_services() {
  compose up -d --force-recreate
}

version() {
  local ver commit
  ver=$(sed -n 's/^__version__ = "\(.*\)"/\1/p' "$INSTALL_DIR/backend/netpulse/__init__.py" 2>/dev/null || echo "?")
  commit=$(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null || echo "?")
  echo "UplinkView $ver ($commit)"
}

wait_healthy() {
  local port
  port=$(sed -n 's/^NETPULSE_PORT=//p' "$ENV_FILE" 2>/dev/null)
  port=${port:-8000}
  c_info "Czekam na start usług..."
  for _ in $(seq 1 60); do
    if curl -fsS "http://127.0.0.1:${port}/api/health" >/dev/null 2>&1; then
      c_ok "UplinkView działa: http://$(hostname -I | awk '{print $1}'):${port}"
      return 0
    fi
    sleep 2
  done
  c_err "API nie odpowiada – sprawdź: uplinkview logs"
  return 1
}

# --- miejsce na dysku -----------------------------------------------------------
# Budowanie obrazu (Node + Python) potrzebuje kilku GB; bez miejsca Docker kończy się długim błędem.
MIN_FREE_MB="${NETPULSE_MIN_FREE_MB:-2000}"   # poniżej tego aktualizacja się zatrzymuje
WARN_FREE_MB="${NETPULSE_WARN_FREE_MB:-4000}" # poniżej tego czyścimy i ostrzegamy
KEEP_CACHE_HOURS="${NETPULSE_KEEP_BUILD_CACHE_HOURS:-72}"
BUILD_CACHE_MAX="${NETPULSE_BUILD_CACHE_MAX:-2gb}"     # górny limit cache budowania

# Wolne miejsce (MB) tam, gdzie Docker trzyma dane
docker_free_mb() {
  local dir
  dir=$(docker info -f '{{.DockerRootDir}}' 2>/dev/null || true)
  [ -d "$dir" ] || dir=/var/lib/docker
  [ -d "$dir" ] || dir=/
  df -Pk "$dir" 2>/dev/null | awk 'NR==2 {print int($4/1024)}'
}

# Usuwa nieużywane dane Dockera. Wolumeny (baza z historią metryk) są nietykalne.
clean_docker() {
  docker builder prune -af >/dev/null 2>&1 || true
  docker image prune -f >/dev/null 2>&1 || true
}

# Po aktualizacji: zostaw świeży cache (kolejna aktualizacja będzie szybka), usuń stary i przytnij całość
# do BUILD_CACHE_MAX (--max-used-space ma Docker 28+, starszy zna to samo jako --keep-storage)
prune_build_cache() {
  docker builder prune -f --filter "until=${KEEP_CACHE_HOURS}h" >/dev/null 2>&1 || true
  docker builder prune -f --max-used-space "$BUILD_CACHE_MAX" >/dev/null 2>&1     || docker builder prune -f --keep-storage "$BUILD_CACHE_MAX" >/dev/null 2>&1 || true
  docker image prune -f >/dev/null 2>&1 || true
}

# Zwraca 1, gdy miejsca jest za mało na budowanie (po próbie automatycznego sprzątania)
check_disk() {
  local free
  free=$(docker_free_mb)
  case "$free" in '' | *[!0-9]*) return 0 ;; esac # nie umiemy sprawdzić – nie blokujemy
  if [ "$free" -lt "$WARN_FREE_MB" ]; then
    c_info "Mało wolnego miejsca (${free} MB) – czyszczę nieużywane dane Dockera (baza i konfiguracja zostają)..."
    clean_docker
    free=$(docker_free_mb)
  fi
  if [ "$free" -lt "$MIN_FREE_MB" ]; then
    c_err "Za mało miejsca na dysku: wolne ${free} MB, a aktualizacja wymaga co najmniej ${MIN_FREE_MB} MB."
    c_err "Sprawdź: df -h /   oraz   sudo docker system df"
    c_err "Jeśli dysk jest duży, a system używa tylko jego części (LVM): sudo vgs, potem sudo lvextend -r -l +100%FREE /dev/mapper/ubuntu--vg-ubuntu--lv"
    c_err "Nic nie zostało zmienione – po zwolnieniu miejsca uruchom ponownie: uplinkview update"
    return 1
  fi
  if [ "$free" -lt "$WARN_FREE_MB" ]; then
    c_info "Uwaga: wolne ${free} MB – na aktualizację wystarczy, ale warto zwolnić miejsce."
  fi
}

cmd_cleanup() {
  need_root cleanup "$@"
  local before after
  before=$(docker_free_mb)
  clean_docker
  after=$(docker_free_mb)
  c_ok "Wolne miejsce: ${before} MB → ${after} MB (baza i konfiguracja nietknięte)"
}

# Kopia bazy w katalogu backups – te same nazwy i limity co kopie z panelu (updater/netpulse_updater/backups.py):
# update = przed aktualizacją (zostają 3), manual = na żądanie (zostaje 10). Wypisuje ścieżkę pliku.
do_backup() {
  local kind="$1" dir="$INSTALL_DIR/backups" stamp target keep pattern
  stamp=$(date +%Y%m%d-%H%M%S)
  if [ "$kind" = update ]; then
    target="$dir/netpulse-$stamp.sql.gz" keep=3 pattern='netpulse-[0-9]*.sql.gz'
  else
    target="$dir/netpulse-manual-$stamp.sql.gz" keep=10 pattern='netpulse-manual-*.sql.gz'
  fi
  mkdir -p "$dir"
  if ! compose exec -T db pg_dump -U netpulse netpulse | gzip >"$target" || [ "$(stat -c %s "$target")" -lt 100 ]; then
    rm -f "$target"
    return 1
  fi
  chmod 600 "$target"
  # shellcheck disable=SC2012 – nazwy kopii nie mają spacji
  ls -1t "$dir"/$pattern 2>/dev/null | tail -n +$((keep + 1)) | xargs -r rm -f
  echo "$target"
}

db_running() {
  compose ps --status running --services 2>/dev/null | grep -qx db
}

# Kopia bez roota (od 0.43.3): użytkownik z grupy docker zleca ją usłudze updater – tak samo jak panel
# (Ustawienia → Kopia zapasowa). Wynik: ta sama nazwa i ten sam katalog backups.
backup_via_updater() {
  local container out
  container=$(docker ps -q --filter label=com.docker.compose.service=updater --filter status=running 2>/dev/null | head -n1)
  [ -n "$container" ] || return 1
  c_info "Tworzę kopię bazy (przez usługę updater)..."
  if ! out=$(docker exec "$container" python -c 'from netpulse_updater.backups import Backups; from netpulse_updater.config import Settings; s = Settings.from_env(); b = Backups(s).create("manual"); print(s.backups_dir / b["name"], b["size_bytes"])'); then
    c_err "Nie udało się wykonać kopii bazy."
    exit 1
  fi
  c_ok "Kopia: ${out% *} ($(numfmt --to=iec "${out##* }" 2>/dev/null || echo "${out##* } B"))"
}

cmd_backup() {
  if [ "$(id -u)" -ne 0 ] && docker info >/dev/null 2>&1 && backup_via_updater; then
    return 0
  fi
  need_root backup "$@"
  db_running || { c_err "Baza nie działa – uruchom UplinkView: uplinkview start"; exit 1; }
  c_info "Tworzę kopię bazy..."
  local target
  if ! target=$(do_backup manual); then
    c_err "Nie udało się wykonać kopii bazy."
    exit 1
  fi
  c_ok "Kopia: $target ($(du -h "$target" | cut -f1))"
}

# Podpis aktualizacji (od 0.69.0): commit musi być podpisany kluczem z deploy/update-signers ZAINSTALOWANEJ wersji.
# Bez pliku (wersje sprzed 0.69.0) albo z NETPULSE_UPDATE_VERIFY=off (własne źródło aktualizacji) – bez sprawdzania.
verify_update() {
  local commit="$1" signers="$INSTALL_DIR/deploy/update-signers"
  [ -f "$signers" ] || return 0
  [ "${NETPULSE_UPDATE_VERIFY:-}" = "off" ] && return 0
  grep -qx 'NETPULSE_UPDATE_VERIFY=off' "$ENV_FILE" 2>/dev/null && return 0
  if ! command -v ssh-keygen >/dev/null 2>&1; then
    c_err "Brak programu ssh-keygen (pakiet openssh-client) – nie da się sprawdzić podpisu aktualizacji."
    return 1
  fi
  git -C "$INSTALL_DIR" -c gpg.format=ssh -c "gpg.ssh.allowedSignersFile=$signers" verify-commit "$commit" >/dev/null 2>&1
}

cmd_update() {
  need_root update "$@"
  # Aktualizacja podmienia ten plik – uruchom kopię, żeby bash nie czytał zmienianego skryptu
  if [ -z "${NETPULSE_UPDATE_COPY:-}" ]; then
    local tmp
    tmp=$(mktemp /tmp/netpulse-update.XXXXXX)
    cp "$(readlink -f "$0")" "$tmp"
    NETPULSE_UPDATE_COPY="$tmp" NETPULSE_DIR="$INSTALL_DIR" exec bash "$tmp" update "$@"
  fi
  trap 'rm -f "$NETPULSE_UPDATE_COPY"' EXIT
  cd "$INSTALL_DIR"
  local branch before after
  branch=$(git rev-parse --abbrev-ref HEAD)
  before=$(git rev-parse HEAD)
  c_info "Sprawdzam aktualizacje ($branch)..."
  np_migrate_origin
  git fetch --quiet origin "$branch"
  after=$(git rev-parse "origin/$branch")
  if [ "$before" = "$after" ] && [ "${1:-}" != "--force" ]; then
    c_ok "Masz najnowszą wersję: $(version)"
    return 0
  fi
  if [ "$before" != "$after" ]; then
    if ! verify_update "$after"; then
      c_err "Aktualizacja w źródle nie ma prawidłowego podpisu UplinkView – nie zostanie zainstalowana. Nic nie zostało zmienione."
      c_err "Jeśli świadomie używasz własnego źródła aktualizacji, ustaw NETPULSE_UPDATE_VERIFY=off w deploy/.env."
      exit 1
    fi
    echo "Zmiany:"
    git log --oneline --no-decorate "$before..$after" | sed 's/^/  /'
  fi
  # Miejsce sprawdzamy PRZED zmianą kodu: przy niepowodzeniu nic się nie zmienia i wystarczy ponowić update
  check_disk || exit 1
  # Kopia bazy przed zmianą kodu (nowa wersja może migrować schemat), jak przy aktualizacji z panelu
  if db_running; then
    local backup
    if ! backup=$(do_backup update); then
      c_err "Nie udało się wykonać kopii bazy, więc aktualizacji nie rozpoczęto. Nic nie zostało zmienione."
      exit 1
    fi
    c_ok "Kopia bazy: $backup"
  fi
  if [ "$before" != "$after" ]; then
    # dokładnie ten commit, którego podpis sprawdziliśmy
    git merge --ff-only --quiet "$after"
  fi
  # Uzupełnij .env o nowe zmienne z .env.example (bez nadpisywania istniejących)
  while IFS='=' read -r key value; do
    case "$key" in ''|\#*) continue ;; esac
    grep -q "^${key}=" "$ENV_FILE" && continue
    # Katalog instalacji ma być faktycznym katalogiem tej instalacji, nie wartością z przykładu
    [ "$key" = "NETPULSE_DIR" ] && value="$INSTALL_DIR"
    echo "${key}=${value}" >>"$ENV_FILE"
  done <"$INSTALL_DIR/deploy/.env.example"
  np_fill_tls_names "$ENV_FILE"
  c_info "Buduję i uruchamiam nową wersję..."
  if ! compose up -d --build --remove-orphans; then
    c_err "Budowanie nie powiodło się. Usługi działają dalej na poprzedniej wersji."
    c_err "Usuń przyczynę (np. zwolnij miejsce: uplinkview cleanup) i uruchom: uplinkview update --force"
    exit 1
  fi
  prune_build_cache
  wait_healthy
  c_ok "Zaktualizowano do: $(version)"
}

cmd_reset() {
  need_root reset "$@"
  echo "Usunięte zostaną wszystkie urządzenia i cała historia metryk. Konfiguracja (.env) zostaje."
  read -r -p "Wyczyścić bazę UplinkView? [t/N] " ans
  [[ "$ans" =~ ^[tTyY]$ ]] || exit 0
  compose down -v
  compose up -d
  wait_healthy
  c_ok "Baza wyczyszczona. Dodaj urządzenia: uplinkview device add NAZWA IP --community public"
}

cmd_uninstall() {
  need_root uninstall "$@"
  read -r -p "Usunąć UplinkView z tego serwera? [t/N] " ans
  [[ "$ans" =~ ^[tTyY]$ ]] || exit 0
  read -r -p "Usunąć też bazę danych z historią metryk? [t/N] " data
  if [[ "$data" =~ ^[tTyY]$ ]]; then
    compose down -v --rmi local
  else
    compose down --rmi local
    c_info "Dane zostały w wolumenie Dockera 'netpulse_db-data'."
  fi
  rm -f /usr/local/bin/netpulse /usr/local/bin/uplinkview
  rm -rf "$INSTALL_DIR"
  c_ok "UplinkView usunięty."
}

main() {
  if [ ! -f "$COMPOSE_FILE" ]; then
    c_err "Nie znaleziono instalacji w $INSTALL_DIR"
    exit 1
  fi
  local cmd="${1:-help}"
  shift || true
  np_ensure_links
  case "$cmd" in
    update) cmd_update "$@" ;;
    status) need_root status; compose ps ;;
    logs) need_root logs "$@"; compose logs -f --tail=100 "$@" ;;
    restart) need_root restart; restart_services && wait_healthy ;;
    stop) need_root stop; compose stop ;;
    start) need_root start; compose up -d && wait_healthy ;;
    version | --version | -V) version ;;
    uninstall) cmd_uninstall "$@" ;;
    reset) cmd_reset "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    backup) cmd_backup "$@" ;;
    help | -h | --help)
      awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
      ;;
    *)
      need_root "$cmd" "$@"
      if [ -t 0 ] && [ -t 1 ]; then
        compose exec collector netpulse "$cmd" "$@"
      else
        compose exec -T collector netpulse "$cmd" "$@"
      fi
      ;;
  esac
}

# Plik można załadować (source) w testach bez uruchamiania poleceń
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
