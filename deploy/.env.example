# NetPulse – configuration. install.sh copies this file to deploy/.env
# and replaces every "CHANGE_ME" with a random value.

# Port of the NetPulse panel/API on the server: http://<server-ip>:8080
NETPULSE_PORT=8080

# PostgreSQL / TimescaleDB
POSTGRES_DB=netpulse
POSTGRES_USER=netpulse
POSTGRES_PASSWORD=CHANGE_ME

# Reserved for login sessions and encrypting stored SNMP secrets (step 4).
SECRET_KEY=CHANGE_ME

LOG_LEVEL=INFO
