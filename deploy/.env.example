# Kopia tego pliku jako deploy/.env – install.sh tworzy ją automatycznie z losowym hasłem.

# Hasło do bazy danych
POSTGRES_PASSWORD=zmien-mnie

# Port panelu/API na serwerze
NETPULSE_PORT=8000

# Co ile sekund odpytywać urządzenia
NETPULSE_POLL_INTERVAL=30

# Ile dni trzymać szczegółowe metryki
NETPULSE_RETENTION_DAYS=30

NETPULSE_LOG_LEVEL=INFO
TZ=Europe/Warsaw

# Katalog instalacji na serwerze (ta sama ścieżka jest używana w kontenerze aktualizacji)
NETPULSE_DIR=/opt/netpulse

# Aktualizacja z panelu (Ustawienia → Aktualizacja): "on" (domyślnie) albo "off" – wtedy panel
# podpowiada tylko polecenie netpulse update. Token do rozmowy API ↔ usługa aktualizacji
# powstaje sam przy pierwszym starcie (wolumen Docker, nie ten plik).
#NETPULSE_UPDATER=on

# Opcjonalnie: inne źródło aktualizacji (adres repozytorium git) i gałąź
#NETPULSE_UPDATE_REPO=
#NETPULSE_UPDATE_BRANCH=
